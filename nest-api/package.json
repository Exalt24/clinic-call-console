{
  "name": "clinic-call-console-nest-api",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS and PostgreSQL implementation of the clinic call console API contract",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "test": "jest --config jest.config.js --runInBand",
    "test:unit": "jest --config jest.config.js --runInBand --selectProjects unit",
    "test:e2e": "jest --config jest.config.js --runInBand --selectProjects e2e",
    "mutation": "python scripts/mutation_check.py"
  },
  "dependencies": {
    "@nestjs/common": "~11.2.8",
    "@nestjs/core": "~11.2.8",
    "@nestjs/jwt": "~11.0.2",
    "@nestjs/platform-express": "~11.2.8",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "~0.3.31"
  },
  "devDependencies": {
    "@nestjs/testing": "~11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~7.0.2"
  }
}
